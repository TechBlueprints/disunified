#!/bin/sh
# disunified's postinst: runs on install and upgrade (and on a SONiC
# image's first boot, when rc.local installs the deb carried into the new
# image's platform directory: docs/drivers/sonic-on-switch.md §5). On a
# Proxmox node it makes the config and state directories, root only
# (docs/drivers/proxmox-on-node.md §2).
set -e

case "$1" in
configure) ;;
*) exit 0 ;;
esac

if [ -f /host/machine.conf ]; then            # a SONiC host: persist in /host
    u=admin                                   # SONiC's login user
    [ -d /host/disunified ] || install -d -m 0700 -o "$u" -g "$u" /host/disunified
    [ -e /etc/disunified ] || ln -s /host/disunified /etc/disunified
    install -d /etc/systemd/system/disunified.service.d
    {
        printf '[Service]\nUser=%s\nGroup=%s\n' "$u" "$u"
        # The resolver file is on a tmpfs: SONiC writes it from the saved
        # DNS servers (CONFIG_DB DNS_NAMESERVER, the controller's last push)
        # in resolv-config.service, which runs well after the bridge starts.
        # Run the same step first (as root, a failure ignored) so the saved
        # servers answer from the bridge's first lookup of a boot.
        if [ -x /usr/bin/resolv-config.sh ]; then
            printf 'ExecStartPre=-+/usr/bin/timeout 30 /usr/bin/resolv-config.sh start\n'
        fi
    } > /etc/systemd/system/disunified.service.d/sonic.conf
else                                          # elsewhere (a Proxmox node): root
    [ -d /etc/disunified ] || install -d -m 0700 -o root -g root /etc/disunified
    [ -d /var/lib/disunified ] || install -d -m 0700 -o root -g root /var/lib/disunified
fi
systemctl enable disunified >/dev/null 2>&1 || true
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    # Start only with a config in place: a fresh install has none yet.
    # --no-block: on a SONiC first boot this runs inside rc.local, and a
    # restart that waited for swss (After=) could wait on rc.local itself.
    if [ -f /etc/disunified/config.yaml ]; then systemctl --no-block restart disunified; fi
fi
exit 0
