# Secrets for disunified. Copy to a file the container reads with
# --env-file (Podman/Docker) and keep it out of version control.
#
# DUI_ is the current prefix. The pre-rename STU_ names (STU_SWITCH_USER,
# STU_SWITCH_PASS, STU_UNIFI_API_KEY) are still read, so an existing env
# file keeps working; new installs use the DUI_ names below.
DUI_DEVICE_USER=stu
DUI_DEVICE_PASS=change-me
DUI_UNIFI_API_KEY=change-me
