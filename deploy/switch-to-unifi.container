# Podman Quadlet unit: copy to /etc/containers/systemd/switch-to-unifi.container
# (rootful) or ~/.config/containers/systemd/ (rootless), then
#   systemctl daemon-reload && systemctl start switch-to-unifi
# Config: /etc/switch-to-unifi/config.yaml; secrets: /etc/switch-to-unifi/env.
[Unit]
Description=switch-to-unifi bridge
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/techblueprints/switch-to-unifi:latest
EnvironmentFile=/etc/switch-to-unifi/env
Volume=/etc/switch-to-unifi/config.yaml:/etc/switch-to-unifi/config.yaml:ro,Z
Volume=switch-to-unifi-state:/var/lib/switch-to-unifi:Z
AutoUpdate=registry

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
