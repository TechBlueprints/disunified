# Go
/bin/
/dist/
*.deb
*.exe
*.test
*.out
coverage.*
vendor/

# Local config and secrets
.env
.env.*
*.local
config.local.*

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# runtime output
/inform-log/
/state/
/run.log
/disunified
/config.yaml
/state-backup/
/config-proxmox.local.yaml

# Site-specific information (addresses, names, topology, deployment hosts,
# credentials): never tracked. Only the README explaining the folder is.
/local-information/*
!/local-information/README.md

# Key material, wherever it lands
/ssh/
id_ed25519*
id_rsa*
id_ecdsa*
*.pem
known_hosts*
authorized_keys

# the SONiC image kit's work clones and build trees stay outside the repo
contrib/sonic-image/src
contrib/sonic-image/dryrun
contrib/sonic-image/inspect
contrib/sonic-image/vs-test
contrib/sonic-image/*.tgz
contrib/sonic-image/dry-run.log
