+                pbuf_append(&j, "Vlan:%d, GA:%s, Ports: count:%d List:",vlan_id, inet_ntoa(ipadr), mcgrp_entry->num_mbr_ports);
             }
             else
             {
@@ -211,8 +231,8 @@ void l2mcd_dump_groups(int vid, int flag)
