+        {
+          m_readyLags.insert(key);
+        }
+        SWSS_LOG_NOTICE("L2MCD_CFG: IF:%s op:%s oper:%d", key.c_str(), op.c_str(),ports[0].oper_state);
+        sendMsgL2Mcd(L2MCD_SNOOP_PORT_LIST_MSG, msg_len, (void *)msg);
+        it = consumer.m_toSync.erase(it);
+    }
+}
