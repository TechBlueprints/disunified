+/* A LAG's L2MC group members, taken out of the chip before its distributing
+ * members change and made again after (PortsOrch::doLagMemberTask). The
+ * Broadcom legacy-TH SAI (libsaibcm 13.2.1) programs a LAG's member as one
+ * egress per LAG member then distributing and never follows a change: a
+ * member that starts distributing later gets no copy of the group's frames,
+ * one that stops keeps them, and removing the L2MC member, which takes one
+ * egress per member distributing at that time, is refused
+ * SAI_STATUS_ITEM_NOT_FOUND for a port it never added -- after removing the
+ * ports before it, so not even the original set can remove it again (seen on
+ * a Celestica DX010, 2026-11-15). Made again, the member takes the new set.
+ * The records, the counts and the group's ref_count stay: the member is gone
+ * from the chip only between the two calls. */
+bool L2mcOrch::detachLagMembers(const Port &lag)
+{
+    SWSS_LOG_ENTER();
+
+    bool detached = false;
+    for (auto &v : m_syncdL2mcEntries)
+    {
+        for (auto &e : v.second)
+        {
+            auto m = e.second.l2mc_group_members.find(lag.m_alias);
+            if (m == e.second.l2mc_group_members.end() || m->second.l2mc_member_id == SAI_NULL_OBJECT_ID)
+                continue;
+            sai_status_t status = sai_l2mc_group_api->remove_l2mc_group_member(m->second.l2mc_member_id);
+            if (status != SAI_STATUS_SUCCESS)
+            {
+                /* Kept as it is: the next change of the set may let it go */
+                SWSS_LOG_ERROR("detachLagMembers: (%s,%s,%s) failed to take l2mc group member %lx of %s out before its LAG members change, rv:%d",
+                               e.first.source_address.to_string().c_str(), e.first.group_address.to_string().c_str(),
+                               v.first.c_str(), m->second.l2mc_member_id, lag.m_alias.c_str(), status);
+                continue;
+            }
+            m->second.l2mc_member_id = SAI_NULL_OBJECT_ID;
+            detached = true;
+        }
+    }
+    return detached;
+}
+
+void L2mcOrch::attachLagMembers(const Port &lag)
+{
+    SWSS_LOG_ENTER();
+
+    size_t made = 0;
+    for (auto &v : m_syncdL2mcEntries)
+    {
+        vector<L2mcGroupKey> lost;
+        for (auto &e : v.second)
+        {
+            auto m = e.second.l2mc_group_members.find(lag.m_alias);
+            if (m == e.second.l2mc_group_members.end() || m->second.l2mc_member_id != SAI_NULL_OBJECT_ID)
+                continue;
+
+            vector<sai_attribute_t> attrs(2);
+            attrs[0].id = SAI_L2MC_GROUP_MEMBER_ATTR_L2MC_GROUP_ID;
+            attrs[0].value.oid = e.second.l2mc_group_id;
+            attrs[1].id = SAI_L2MC_GROUP_MEMBER_ATTR_L2MC_OUTPUT_ID;
+            attrs[1].value.oid = lag.m_bridge_port_id;
+            sai_object_id_t member_id = SAI_NULL_OBJECT_ID;
+            sai_status_t status = sai_l2mc_group_api->create_l2mc_group_member(&member_id, gSwitchId,
+                                                                              (uint32_t)attrs.size(), attrs.data());
+            if (status != SAI_STATUS_SUCCESS)
+            {
+                /* No member in the chip: the record goes too, counted off */
+                SWSS_LOG_ERROR("attachLagMembers: (%s,%s,%s) failed to make l2mc group member %s again, rv:%d; dropped",
+                               e.first.source_address.to_string().c_str(), e.first.group_address.to_string().c_str(),
+                               v.first.c_str(), lag.m_alias.c_str(), status);
+                if (m->second.is_l2mc_member)
+                    e.second.ref_count--;
+                e.second.l2mc_group_members.erase(m);
+                countMember(lag.m_alias, v.first, false);
+                if (e.second.ref_count <= 0)
+                    lost.push_back(e.first);
+                continue;
+            }
+            m->second.l2mc_member_id = member_id;
+            made++;
+        }
+        Port vlan;
+        if (!lost.empty() && gPortsOrch->getPort(v.first, vlan))
+        {
+            for (const auto &key : lost)
+                RemoveL2mcEntry(key, vlan);
+        }
+    }
+    if (made)
+        SWSS_LOG_NOTICE("attachLagMembers: %zu l2mc group members of %s made again for its LAG members", made, lag.m_alias.c_str());
+}
