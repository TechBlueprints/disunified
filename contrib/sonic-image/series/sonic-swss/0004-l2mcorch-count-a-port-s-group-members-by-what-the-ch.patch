+/* Port::m_l2mc_count is the number of SAI L2MC group members whose output is
+ * the port's bridge port, whichever path created them (a group member or a
+ * multicast router port): removeBridgePort relies on it. The VLAN's count
+ * follows. Kept in PortsOrch's own copy; *port, when given, is the caller's
+ * copy, brought in step. */
+void L2mcOrch::countMember(const string &port_alias, const string &vlan_alias, bool add, Port *port)
+{
+    Port p, vlan;
+
+    if (gPortsOrch->getPort(port_alias, p))
+    {
+        if (add)
+        {
+            p.m_l2mc_count++;
+        }
+        else if (p.m_l2mc_count > 0)
+        {
+            p.m_l2mc_count--;
+        }
+        else
+        {
+            SWSS_LOG_ERROR("port %s: an l2mc group member removed with none counted", port_alias.c_str());
+        }
+        gPortsOrch->setPort(port_alias, p);
+        if (port)
+        {
+            port->m_l2mc_count = p.m_l2mc_count;
+        }
+    }
+    if (gPortsOrch->getPort(vlan_alias, vlan))
+    {
+        if (add)
+        {
+            vlan.m_l2mc_count++;
+        }
+        else if (vlan.m_l2mc_count > 0)
+        {
+            vlan.m_l2mc_count--;
+        }
+        gPortsOrch->setPort(vlan_alias, vlan);
+    }
+    SWSS_LOG_NOTICE("port %s l2mc_count %u vlan %s l2mc_count %u",
+        port_alias.c_str(), p.m_l2mc_count, vlan_alias.c_str(), vlan.m_l2mc_count);
+}
