+/* Drop every group member whose output is the port's bridge port, in one VLAN
+ * (the port is leaving it) or in all of them (its bridge port is about to go),
+ * and the port's place in those VLANs' router-port lists, without waiting for
+ * the deletes l2mcd sends: a member outside its VLAN carries nothing, and a
+ * bridge port removal that waits on them was refused with the bridge port
+ * already down. A group left without a member goes, as on a leave. l2mcd's
+ * later deletes find nothing and are done. */
+bool L2mcOrch::removeL2mcPortMembers(const Port &port, const string &vlan_alias)
+{
+    SWSS_LOG_ENTER();
+
+    vector<string> vlans;
+    for (const auto &v : m_syncdL2mcEntries)
+    {
+        if (vlan_alias.empty() || v.first == vlan_alias)
+            vlans.push_back(v.first);
+    }
+    for (const auto &v : vlans)
+    {
+        vector<L2mcGroupKey> emptied;
+        for (auto &e : m_syncdL2mcEntries.at(v))
+        {
+            auto m = e.second.l2mc_group_members.find(port.m_alias);
+            if (m == e.second.l2mc_group_members.end())
+                continue;
+            sai_status_t status = sai_l2mc_group_api->remove_l2mc_group_member(m->second.l2mc_member_id);
+            if (status != SAI_STATUS_SUCCESS)
+            {
+                SWSS_LOG_ERROR("removeL2mcPortMembers: Failed to remove l2mc group member %lx of %s from l2mc-grp:%lx rv:%d",
+                               m->second.l2mc_member_id, port.m_alias.c_str(), e.second.l2mc_group_id, status);
+                return false;
+            }
+            SWSS_LOG_NOTICE("removeL2mcPortMembers: (%s,%s,%s) l2mc group member %s removed with its port",
+                            e.first.source_address.to_string().c_str(), e.first.group_address.to_string().c_str(),
+                            v.c_str(), port.m_alias.c_str());
+            if (m->second.is_l2mc_member)
+                e.second.ref_count--;
+            e.second.l2mc_group_members.erase(m);
+            countMember(port.m_alias, v, false);
+            if (e.second.ref_count <= 0)
+                emptied.push_back(e.first);
+        }
+        Port vlan;
+        if (!emptied.empty() && gPortsOrch->getPort(v, vlan))
+        {
+            for (const auto &key : emptied)
+                RemoveL2mcEntry(key, vlan);
+        }
+    }
+    for (auto *lists : {&mrouter_ports_ipv4_per_vlan, &mrouter_ports_ipv6_per_vlan})
+    {
+        for (auto it = lists->begin(); it != lists->end();)
+        {
+            if (vlan_alias.empty() || it->first == vlan_alias)
+            {
+                auto &ports = it->second;
+                ports.erase(std::remove(ports.begin(), ports.end(), port.m_alias), ports.end());
+            }
+            if (it->second.empty())
+                it = lists->erase(it);
+            else
+                it++;
+        }
+    }
+    return true;
+}
