+{
+    using namespace std;
+    using namespace swss;
+    using namespace mock_orch_test;
+
+    static const string G1 = "224.0.1.1";
+    static const string G2 = "224.0.1.22";
+    static const string G3 = "224.0.1.60";
+
+    /* The chip's L2MC objects, as far as the test needs them: every member
+     * and the bridge port it outputs to. */
+    static map<sai_object_id_t, sai_object_id_t> g_members;
+    static sai_object_id_t g_next_oid = 0x7700000000000001;
+
+    static sai_status_t ut_create_l2mc_group(sai_object_id_t *oid, sai_object_id_t, uint32_t, const sai_attribute_t *)
+    {
+        *oid = g_next_oid++;
+        return SAI_STATUS_SUCCESS;
+    }
+    static sai_status_t ut_remove_l2mc_group(sai_object_id_t)
+    {
+        return SAI_STATUS_SUCCESS;
+    }
+    static sai_status_t ut_create_l2mc_group_member(sai_object_id_t *oid, sai_object_id_t, uint32_t count, const sai_attribute_t *attrs)
+    {
+        sai_object_id_t out = SAI_NULL_OBJECT_ID;
+        for (uint32_t i = 0; i < count; i++)
+        {
+            if (attrs[i].id == SAI_L2MC_GROUP_MEMBER_ATTR_L2MC_OUTPUT_ID)
+                out = attrs[i].value.oid;
+        }
+        if (out == SAI_NULL_OBJECT_ID)
+            return SAI_STATUS_INVALID_PARAMETER;
+        *oid = g_next_oid++;
+        g_members[*oid] = out;
+        return SAI_STATUS_SUCCESS;
+    }
+    static sai_status_t ut_remove_l2mc_group_member(sai_object_id_t oid)
+    {
+        return g_members.erase(oid) ? SAI_STATUS_SUCCESS : SAI_STATUS_ITEM_NOT_FOUND;
+    }
+    static sai_status_t ut_create_l2mc_entry(const sai_l2mc_entry_t *, uint32_t, const sai_attribute_t *)
+    {
+        return SAI_STATUS_SUCCESS;
+    }
+    static sai_status_t ut_remove_l2mc_entry(const sai_l2mc_entry_t *)
+    {
+        return SAI_STATUS_SUCCESS;
+    }
+    static sai_status_t ut_get_switch_attribute(sai_object_id_t, uint32_t, sai_attribute_t *)
+    {
+        return SAI_STATUS_SUCCESS;
+    }
+    static sai_status_t ut_flush_fdb_entries(sai_object_id_t, uint32_t, const sai_attribute_t *)
+    {
+        return SAI_STATUS_SUCCESS;
+    }
+
+    class L2mcOrchTest : public MockOrchTest
+    {
+    protected:
+        sai_l2mc_group_api_t ut_group_api, *org_group_api;
+        sai_l2mc_api_t ut_entry_api, *org_entry_api;
+        sai_switch_api_t ut_switch_api, *org_switch_api;
+        sai_fdb_api_t ut_fdb_api, *org_fdb_api;
+
+        void ApplyInitialConfigs() override
+        {
+            Table port_table = Table(m_app_db.get(), APP_PORT_TABLE_NAME);
+            Table vlan_table = Table(m_app_db.get(), APP_VLAN_TABLE_NAME);
+            Table vlan_member_table = Table(m_app_db.get(), APP_VLAN_MEMBER_TABLE_NAME);
+
+            auto ports = ut_helper::getInitialSaiPorts();
+            port_table.set(ETHERNET0, ports[ETHERNET0]);
+            port_table.set(ETHERNET4, ports[ETHERNET4]);
+            port_table.set("PortConfigDone", { { "count", to_string(1) } });
+            port_table.set("PortInitDone", { {} });
+
+            for (const auto &v : { VLAN_1000, VLAN_2000 })
+            {
+                vlan_table.set(v, { { "admin_status", "up" }, { "mtu", "9100" }, { "mac", "02:00:00:00:00:01" } });
+            }
+            const string sep = vlan_member_table.getTableNameSeparator();
+            vlan_member_table.set(VLAN_1000 + sep + ETHERNET0, { { "tagging_mode", "untagged" } });
+            vlan_member_table.set(VLAN_1000 + sep + ETHERNET4, { { "tagging_mode", "untagged" } });
+
+            gPortsOrch->addExistingData(&port_table);
+            gPortsOrch->addExistingData(&vlan_table);
+            gPortsOrch->addExistingData(&vlan_member_table);
+            static_cast<Orch *>(gPortsOrch)->doTask();
+        }
+
+        void PostSetUp() override
+        {
+            g_members.clear();
+
+            org_group_api = sai_l2mc_group_api;
+            ut_group_api = {};
+            ut_group_api.create_l2mc_group = ut_create_l2mc_group;
+            ut_group_api.remove_l2mc_group = ut_remove_l2mc_group;
+            ut_group_api.create_l2mc_group_member = ut_create_l2mc_group_member;
+            ut_group_api.remove_l2mc_group_member = ut_remove_l2mc_group_member;
+            sai_l2mc_group_api = &ut_group_api;
+
+            org_entry_api = sai_l2mc_entry_api;
+            ut_entry_api = {};
+            ut_entry_api.create_l2mc_entry = ut_create_l2mc_entry;
+            ut_entry_api.remove_l2mc_entry = ut_remove_l2mc_entry;
+            sai_l2mc_entry_api = &ut_entry_api;
+
+            org_switch_api = sai_switch_api;
+            ut_switch_api = *sai_switch_api;
+            ut_switch_api.get_switch_attribute = ut_get_switch_attribute;
+            sai_switch_api = &ut_switch_api;
+
+            org_fdb_api = sai_fdb_api;
+            ut_fdb_api = *sai_fdb_api;
+            ut_fdb_api.flush_fdb_entries = ut_flush_fdb_entries;
+            sai_fdb_api = &ut_fdb_api;
+
+            vector<string> stp_tables = { "STP_TABLE", "STP_VLAN_INSTANCE_TABLE", "STP_PORT_STATE_TABLE",
+                                          "STP_FASTAGEING_FLUSH_TABLE", "STP_INST_PORT_FLUSH_TABLE" };
+            gStpOrch = new StpOrch(m_app_db.get(), m_state_db.get(), stp_tables);
+
+            vector<string> l2mc_tables = { APP_L2MC_VLAN_TABLE_NAME, APP_L2MC_MEMBER_TABLE_NAME,
+                                           APP_L2MC_MROUTER_TABLE_NAME, APP_L2MC_SUPPRESS_TABLE_NAME };
+            gL2mcOrch = new L2mcOrch(m_app_db.get(), l2mc_tables);
+        }
+
+        void PreTearDown() override
+        {
+            delete gL2mcOrch;
+            gL2mcOrch = nullptr;
+            delete gStpOrch;
+            gStpOrch = nullptr;
+            sai_l2mc_group_api = org_group_api;
+            sai_l2mc_entry_api = org_entry_api;
+            sai_switch_api = org_switch_api;
+            sai_fdb_api = org_fdb_api;
+        }
+
+        void l2mc(const string &table, const string &key, const string &op)
+        {
+            auto consumer = dynamic_cast<Consumer *>(gL2mcOrch->getExecutor(table));
+            consumer->addToSync({ { key, op, {} } });
+            static_cast<Orch *>(gL2mcOrch)->doTask();
+        }
+        void member(const string &group, const string &port, const string &op)
+        {
+            l2mc(APP_L2MC_MEMBER_TABLE_NAME, VLAN_1000 + ":0.0.0.0:" + group + ":" + port, op);
+        }
+        void mrouter(const string &port, const string &op)
+        {
+            l2mc(APP_L2MC_MROUTER_TABLE_NAME, VLAN_1000 + ":" + port + ":V4", op);
+        }
+        void vlanMembers(deque<KeyOpFieldsValuesTuple> entries)
+        {
+            auto consumer = dynamic_cast<Consumer *>(gPortsOrch->getExecutor(APP_VLAN_MEMBER_TABLE_NAME));
+            consumer->addToSync(entries);
+            static_cast<Orch *>(gPortsOrch)->doTask();
+        }
+        size_t pendingVlanMembers()
+        {
+            auto consumer = dynamic_cast<Consumer *>(gPortsOrch->getExecutor(APP_VLAN_MEMBER_TABLE_NAME));
+            return consumer->m_toSync.size();
+        }
+
+        Port port(const string &alias)
+        {
+            Port p;
+            EXPECT_TRUE(gPortsOrch->getPort(alias, p));
+            return p;
+        }
+        /* SAI members whose output is the port's bridge port */
+        size_t chipMembers(const string &alias)
+        {
+            sai_object_id_t bp = port(alias).m_bridge_port_id;
+            size_t n = 0;
+            for (const auto &m : g_members)
+                n += m.second == bp;
+            return n;
+        }
+        bool bridgePortUp(const string &alias)
+        {
+            sai_attribute_t attr;
+            attr.id = SAI_BRIDGE_PORT_ATTR_ADMIN_STATE;
+            EXPECT_EQ(sai_bridge_api->get_bridge_port_attribute(port(alias).m_bridge_port_id, 1, &attr), SAI_STATUS_SUCCESS);
+            return attr.value.booldata;
+        }
+        /* every group's ref_count is its group members, router ports not */
+        void expectRefCounts()
+        {
+            for (const auto &v : gL2mcOrch->m_syncdL2mcEntries)
+            {
+                for (const auto &e : v.second)
+                {
+                    int members = 0;
+                    for (const auto &m : e.second.l2mc_group_members)
+                        members += m.second.is_l2mc_member;
+                    EXPECT_EQ(e.second.ref_count, members) << e.first.group_address.to_string();
+                }
+            }
+        }
+    };
+
+    /* The DX010's 09:11-09:12 sequence: Ethernet32 a static member of the
+     * reserved groups beside the uplink, learned as a router port on a loop,
+     * a member of a group it had only as a router port, then its link down:
+     * l2mcd's member deletes arrive while it is still a router port, the
+     * router port's delete after them. */
+    TEST_F(L2mcOrchTest, RouterPortThatIsAMemberGoesDown)
+    {
+        member(G1, ETHERNET0, SET_COMMAND);
+        member(G1, ETHERNET4, SET_COMMAND);
+        member(G2, ETHERNET0, SET_COMMAND);
+        member(G2, ETHERNET4, SET_COMMAND);
+        member(G3, ETHERNET0, SET_COMMAND);
+        mrouter(ETHERNET4, SET_COMMAND); /* joins G3 as a router port */
+        ASSERT_EQ(chipMembers(ETHERNET4), 3u);
+        EXPECT_EQ(port(ETHERNET4).m_l2mc_count, 3u);
+        member(G3, ETHERNET4, SET_COMMAND); /* a member of G3 too */
+        EXPECT_EQ(chipMembers(ETHERNET4), 3u);
+        EXPECT_EQ(port(ETHERNET4).m_l2mc_count, 3u);
+        expectRefCounts();
+
+        member(G1, ETHERNET4, DEL_COMMAND);
+        member(G2, ETHERNET4, DEL_COMMAND);
+        member(G3, ETHERNET4, DEL_COMMAND);
+        expectRefCounts();
+        mrouter(ETHERNET4, DEL_COMMAND);
+
+        EXPECT_EQ(chipMembers(ETHERNET4), 0u);
+        EXPECT_EQ(port(ETHERNET4).m_l2mc_count, 0u);
+        EXPECT_EQ(chipMembers(ETHERNET0), 3u);
+        EXPECT_EQ(port(ETHERNET0).m_l2mc_count, 3u);
+        expectRefCounts();
+
+        /* the native VLAN move that found the bridge port refused */
+        vlanMembers({ { VLAN_1000 + ":" + ETHERNET4, DEL_COMMAND, {} },
+                      { VLAN_2000 + ":" + ETHERNET4, SET_COMMAND, { { "tagging_mode", "untagged" } } } });
+        EXPECT_EQ(pendingVlanMembers(), 0u);
+        EXPECT_TRUE(bridgePortUp(ETHERNET4));
+    }
+
+    /* A router port that becomes a member, then stops being a router port
+     * first: the member stays, counted once, and goes with its delete. */
+    TEST_F(L2mcOrchTest, RouterPortLeavesBeforeTheMember)
+    {
+        member(G1, ETHERNET0, SET_COMMAND);
+        mrouter(ETHERNET4, SET_COMMAND);
+        member(G1, ETHERNET4, SET_COMMAND);
+        mrouter(ETHERNET4, DEL_COMMAND);
+        EXPECT_EQ(chipMembers(ETHERNET4), 1u);
+        EXPECT_EQ(port(ETHERNET4).m_l2mc_count, 1u);
+        member(G1, ETHERNET4, DEL_COMMAND);
+        EXPECT_EQ(chipMembers(ETHERNET4), 0u);
+        EXPECT_EQ(port(ETHERNET4).m_l2mc_count, 0u);
+        expectRefCounts();
+    }
+
+    /* The port leaves its only VLAN for another while l2mcd has not yet
+     * deleted its members there (the driver deleted the static rows just
+     * before): the members go with the VLAN membership, the bridge port is
+     * removed and made again, up, and l2mcd's late deletes find nothing. */
+    TEST_F(L2mcOrchTest, PortLeavesItsVlanWithMembersLeft)
+    {
+        member(G1, ETHERNET0, SET_COMMAND);
+        member(G1, ETHERNET4, SET_COMMAND);
+        member(G2, ETHERNET4, SET_COMMAND);
+        mrouter(ETHERNET4, SET_COMMAND);
+        sai_object_id_t before = port(ETHERNET4).m_bridge_port_id;
+
+        vlanMembers({ { VLAN_1000 + ":" + ETHERNET4, DEL_COMMAND, {} },
+                      { VLAN_2000 + ":" + ETHERNET4, SET_COMMAND, { { "tagging_mode", "untagged" } } } });
+        EXPECT_EQ(pendingVlanMembers(), 0u);
+        EXPECT_NE(port(ETHERNET4).m_bridge_port_id, before);
+        EXPECT_TRUE(bridgePortUp(ETHERNET4));
+        EXPECT_EQ(port(ETHERNET4).m_l2mc_count, 0u);
+        for (const auto &m : g_members)
+            EXPECT_NE(m.second, before);
+        EXPECT_TRUE(gL2mcOrch->m_syncdL2mcEntries[VLAN_1000].count(L2mcGroupKey(VLAN_1000, IpAddress("0.0.0.0"), IpAddress(G1))));
+        EXPECT_FALSE(gL2mcOrch->m_syncdL2mcEntries[VLAN_1000].count(L2mcGroupKey(VLAN_1000, IpAddress("0.0.0.0"), IpAddress(G2))));
+        expectRefCounts();
+
+        member(G1, ETHERNET4, DEL_COMMAND);
+        member(G2, ETHERNET4, DEL_COMMAND);
+        mrouter(ETHERNET4, DEL_COMMAND);
+        EXPECT_EQ(port(ETHERNET4).m_l2mc_count, 0u);
+        EXPECT_EQ(port(ETHERNET0).m_l2mc_count, 1u);
+        expectRefCounts();
+    }
+
+    /* A tagged VLAN taken off a port that keeps another: its members in that
+     * VLAN go with it, the bridge port stays. */
+    TEST_F(L2mcOrchTest, PortLeavesOneOfTwoVlans)
+    {
+        vlanMembers({ { VLAN_2000 + ":" + ETHERNET4, SET_COMMAND, { { "tagging_mode", "tagged" } } } });
+        member(G1, ETHERNET4, SET_COMMAND);
+        sai_object_id_t before = port(ETHERNET4).m_bridge_port_id;
+        vlanMembers({ { VLAN_1000 + ":" + ETHERNET4, DEL_COMMAND, {} } });
+        EXPECT_EQ(pendingVlanMembers(), 0u);
+        EXPECT_EQ(port(ETHERNET4).m_bridge_port_id, before);
+        EXPECT_TRUE(bridgePortUp(ETHERNET4));
+        EXPECT_EQ(chipMembers(ETHERNET4), 0u);
+        EXPECT_EQ(port(ETHERNET4).m_l2mc_count, 0u);
+    }
+}
